# Environment Configuration untuk SonaAI
PORT=3000

# 1. Google Gemini API Key (Dapatkan gratis di https://aistudio.google.com/)
GEMINI_API_KEY=

# 2. Groq API Key - Llama 3.3 70B & Whisper Suara (Dapatkan gratis di https://console.groq.com/)
GROQ_API_KEY=

# 3. OpenRouter API Key - DeepSeek R1/V3, Claude, GPT (Dapatkan di https://openrouter.ai/keys)
OPENROUTER_API_KEY=

# 4. Supabase Cloud Database (HTTPS Port 443 - Bebas Blokir Port)
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SECRET_KEY=sb_secret_xxxx
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxx
DATABASE_URL=
